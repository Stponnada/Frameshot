      "hold": 3
    },
    {
      "caption": "Detail",
      "orbit": { "azimuth": 35, "elevation": 30, "distance": 10 },
      "light": { "exposure": 1.1, "keyIntensity": 6, "keyAzimuth": 60, "keyElevation": 70, "rimIntensity": 4, "ambient": 0.1 },
