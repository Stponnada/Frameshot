      "move": 1,
      "hold": 3
    },
    {
      "caption": "Close",
      "orbit": { "azimuth": 200, "elevation": 20, "distance": 20 },
      "light": { "exposure": 1, "keyIntensity": 1.5, "keyAzimuth": 50, "keyElevation": 15, "rimIntensity": 5, "ambient": 0.1 },
      "title": { "statementLeft": "Product", "statementRight": "Available now" },
